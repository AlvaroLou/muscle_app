{
  "expo": {
    "name": "Workout Planner",
    "slug": "workout-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "workoutplanner",
    "icon": "./assets/halteres.png",
    "splash": {
      "image": "./assets/halteres.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.workoutplanner.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/halteres.png",
        "backgroundColor": "#121212"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-localization"
    ]
  }
}
